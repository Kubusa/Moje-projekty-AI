            updateRank() {
                let rank = "Rekrut";
                if (this.globalScore >= 1000) rank = "Młodszy Inspektor";
                if (this.globalScore >= 2500) rank = "Ekspert Bezpieczeństwa";
                if (this.globalScore >= 4000) rank = "Mistrz Akademii";
                
                document.getElementById('headerLevel').innerText = rank;
