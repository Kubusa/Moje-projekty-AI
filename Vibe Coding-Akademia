        // Zarządzanie widocznością ekranów
        function showScreen(screenId) {
            // Pauzowanie minigry w tle, jeśli zmieniamy ekran
            if (State.arcade.running && screenId !== 'arcadeScreen') {
                quitArcade();
            }

            const screens = ['welcomeScreen', 'zoneSelectScreen', 'scenarioScreen', 'arcadeScreen', 'summaryScreen'];
            screens.forEach(id => {
                const el = document.getElementById(id);
                if (el) {
                    if (id === screenId) {
                        el.classList.remove('hidden');
                    } else {
                        el.classList.add('hidden');
                    }
                }
            });
            State.currentScreen = screenId;
            State.updateBadgeUI();
        }

        function startZoneSelect() {
            showScreen('zoneSelectScreen');
            AudioEngine.playChime();
        }

        // Obsługa stref szkoleniowych
        function launchZone(zoneKey) {
            AudioEngine.playChime();
            State.activeZone = zoneKey;
            State.scenarioIndex = 0;
            // Kopiujemy pytania ze strefy
            State.activeScenarios = [...SCENARIOS[zoneKey]];
            
            showScreen('scenarioScreen');
            renderScenario();
        }

        function renderScenario() {
            if (State.scenarioIndex >= State.activeScenarios.length) {
                // Koniec strefy - odblokowujemy odznakę
                State.unlockBadge(State.activeZone);
                finishZone();
                return;
            }

            const current = State.activeScenarios[State.scenarioIndex];
            
            // Konfiguracja UI
            const zoneLabel = document.getElementById('scenarioZoneLabel');
            const progressLabel = document.getElementById('scenarioProgressLabel');
            const progressBar = document.getElementById('scenarioProgressBar');
            const questionText = document.getElementById('scenarioQuestionText');
            const contextText = document.getElementById('scenarioContext');
            const optionsContainer = document.getElementById('optionsContainer');
            const bgIcon = document.getElementById('bgScenarioIcon');

            // Mapowanie stylów i ikon stref
            let zoneColor = 'text-blue-400';
            let iconClass = 'fa-house-fire';
            if (State.activeZone === 'dom') { zoneColor = 'text-amber-400'; iconClass = 'fa-house-fire'; }
            if (State.activeZone === 'droga') { zoneColor = 'text-blue-400'; iconClass = 'fa-road'; }
            if (State.activeZone === 'cyber') { zoneColor = 'text-emerald-400'; iconClass = 'fa-user-shield'; }
            if (State.activeZone === 'pomoc') { zoneColor = 'text-rose-400'; iconClass = 'fa-kit-medical'; }

            zoneLabel.innerText = `Misja: ${State.activeZone.toUpperCase()}`;
            zoneLabel.className = `font-bold tracking-wider uppercase ${zoneColor}`;
            
            progressLabel.innerText = `Pytanie ${State.scenarioIndex + 1}/${State.activeScenarios.length}`;
            
            const pct = ((State.scenarioIndex) / State.activeScenarios.length) * 100;
            progressBar.style.width = `${pct}%`;

            bgIcon.innerHTML = `<i class="fa-solid ${iconClass}"></i>`;

            questionText.innerText = current.question;
            contextText.innerText = `"${current.context}"`;

            // Generowanie opcji
            optionsContainer.innerHTML = '';
            current.options.forEach((opt, idx) => {
                const btn = document.createElement('button');
                btn.className = "w-full text-left p-4 rounded-xl bg-slate-950/40 border border-slate-800/80 hover:border-slate-600 hover:bg-slate-950/80 text-xs md:text-sm font-semibold transition flex justify-between items-center group relative overflow-hidden";
                btn.innerHTML = `
                    <span class="pr-4 leading-relaxed">${opt.text}</span>
                    <i class="fa-solid fa-chevron-right text-slate-600 group-hover:text-slate-400 transition-colors"></i>
                `;
                btn.onclick = () => selectOption(idx);
                optionsContainer.appendChild(btn);
            });
        }

        function selectOption(index) {
            const current = State.activeScenarios[State.scenarioIndex];
            const option = current.options[index];

            // Konfiguracja Modalu Informacyjnego
            const modal = document.getElementById('feedbackModal');
            const content = document.getElementById('feedbackContent');
            const iconWrap = document.getElementById('feedbackIconWrap');
            const icon = document.getElementById('feedbackIcon');
            const title = document.getElementById('feedbackTitle');
            const text = document.getElementById('feedbackText');
            const nextBtn = document.getElementById('nextScenarioBtn');

            if (option.correct) {
                // Dobra odpowiedź
                AudioEngine.playChime();
                State.addScore(250);
                
                iconWrap.className = "w-16 h-16 rounded-full flex items-center justify-center text-3xl mx-auto bg-emerald-500/10 text-emerald-400";
                icon.className = "fa-solid fa-circle-check animate-bounce";
                title.innerText = "Świetna decyzja!";
                title.className = "heading-font text-2xl font-extrabold text-emerald-400 text-center space-y-3";
                text.innerHTML = option.feedback;
            } else {
                // Zła odpowiedź
                AudioEngine.playBuzzer();
                
                iconWrap.className = "w-16 h-16 rounded-full flex items-center justify-center text-3xl mx-auto bg-rose-500/10 text-rose-400";
                icon.className = "fa-solid fa-triangle-exclamation animate-pulse";
                title.innerText = "Zagrożenie!";
                title.className = "heading-font text-2xl font-extrabold text-rose-500 text-center space-y-3";
                text.innerHTML = `<span class="block mb-2 font-bold text-slate-200">Uważaj:</span> ${option.feedback} <br><br> <span class="text-xs text-amber-400"><strong>Wskazówka:</strong> ${option.hint}</span>`;
            }

            // Pokaż modal z lekkim opóźnieniem / animacją
            modal.classList.remove('hidden');
            setTimeout(() => {
                content.classList.remove('scale-95');
                content.classList.add('scale-100');
            }, 50);
        }

        function dismissFeedback() {
            const modal = document.getElementById('feedbackModal');
            const content = document.getElementById('feedbackContent');
            
            content.classList.remove('scale-100');
            content.classList.add('scale-95');
            
            setTimeout(() => {
                modal.classList.add('hidden');
                // Przejście do kolejnego pytania
                State.scenarioIndex++;
                renderScenario();
            }, 150);
        }

        // Kończenie misji strefowej
        function finishZone() {
            if (State.unlockedBadges.length === 4) {
                // Wszystkie odznaki zdobyte -> Ekran końcowy
                renderSummaryScreen();
            } else {
                // Powrót do menu wyboru stref
                showScreen('zoneSelectScreen');
            }
        }

        function renderSummaryScreen() {
            showScreen('summaryScreen');
            document.getElementById('summaryScore').innerText = State.globalScore;
            
            // Generowanie wizualnych odznak na podsumowaniu
            const badgesContainer = document.getElementById('summaryBadges');
            badgesContainer.innerHTML = '';
            
            const badgeMeta = {
                dom: { icon: 'fa-house-fire', color: 'text-amber-400 bg-amber-500/10 border-amber-500/30', label: 'Dom' },
                droga: { icon: 'fa-road', color: 'text-blue-400 bg-blue-500/10 border-blue-500/30', label: 'Droga' },
                cyber: { icon: 'fa-user-shield', color: 'text-emerald-400 bg-emerald-500/10 border-emerald-500/30', label: 'Cyber' },
                pomoc: { icon: 'fa-kit-medical', color: 'text-rose-400 bg-rose-500/10 border-rose-500/30', label: 'Pomoc' }
            };

            State.unlockedBadges.forEach(bKey => {
                const meta = badgeMeta[bKey];
                if (meta) {
                    const badgeDiv = document.createElement('div');
                    badgeDiv.className = `flex flex-col items-center justify-center p-3 rounded-xl border ${meta.color} w-16 h-16`;
                    badgeDiv.innerHTML = `
                        <i class="fa-solid ${meta.icon} text-lg mb-1"></i>
                        <span class="text-[9px] uppercase font-bold">${meta.label}</span>
                    `;
                    badgesContainer.appendChild(badgeDiv);
                }
            });
        }

        // MINIGRA "ŁAPACZ BEZPIECZEŃSTWA"
        const canvas = document.getElementById('arcadeCanvas');
        const ctx = canvas.getContext('2d');

        // Baza elementów spadających w zręcznościówce
        const ARCADE_ITEMS = [
            // Pozytywne (zielone)
            { text: 'Kask rowerowy', type: 'good', icon: '🚲', color: '#10b981' },
            { text: 'Odblask nocny', type: 'good', icon: '⭐', color: '#10b981' },
            { text: 'Zapięte pasy', type: 'good', icon: '🛡️', color: '#10b981' },
            { text: 'Silne Hasło', type: 'good', icon: '🔑', color: '#10b981' },
            { text: 'Apteczka RKO', type: 'good', icon: '🩹', color: '#10b981' },
            
            // Negatywne (czerwone)
            { text: 'Pożar oleju', type: 'bad', icon: '🔥', color: '#f43f5e' },
            { text: 'Podejrzany link', type: 'bad', icon: '📧', color: '#f43f5e' },
            { text: 'Zepsuty kabel', type: 'bad', icon: '⚡', color: '#f43f5e' },
            { text: 'Czerwone światło', type: 'bad', icon: '🛑', color: '#f43f5e' },
            { text: 'Brak odblasku', type: 'bad', icon: '🚶🏽', color: '#f43f5e' }
        ];

        class FallingElement {
            constructor() {
                const item = ARCADE_ITEMS[Math.floor(Math.random() * ARCADE_ITEMS.length)];
                this.text = item.text;
                this.type = item.type;
                this.icon = item.icon;
                this.color = item.color;
                
                this.radius = 22;
                this.x = Math.random() * (canvas.width - this.radius * 2) + this.radius;
                this.y = -this.radius;
                
                this.speed = (Math.random() * 2 + 1.5) * State.arcade.speedMultiplier;
                this.rotation = 0;
                this.rotSpeed = Math.random() * 0.04 - 0.02;
            }

            draw() {
                ctx.save();
                ctx.translate(this.x, this.y);
                ctx.rotate(this.rotation);

                // Otoczka tarczy
                ctx.beginPath();
                ctx.arc(0, 0, this.radius, 0, Math.PI * 2);
                ctx.fillStyle = 'rgba(15, 23, 42, 0.9)';
                ctx.strokeStyle = this.color;
                ctx.lineWidth = 2.5;
                ctx.shadowBlur = 12;
                ctx.shadowColor = this.color;
                ctx.fill();
                ctx.stroke();

                // Ikona emoji pośrodku
                ctx.font = '20px sans-serif';
                ctx.textAlign = 'center';
                ctx.textBaseline = 'middle';
                ctx.fillText(this.icon, 0, 0);

                ctx.restore();

                // Napis nad lub pod obiektem
                ctx.font = 'bold 9px sans-serif';
                ctx.fillStyle = '#94a3b8';
                ctx.textAlign = 'center';
                ctx.fillText(this.text, this.x, this.y - this.radius - 6);
            }

            update() {
                this.y += this.speed;
                this.rotation += this.rotSpeed;
            }
        }

        // Integracja sterowania
        let keys = { left: false, right: false };

        window.addEventListener('keydown', (e) => {
            if (e.key === 'ArrowLeft' || e.key.toLowerCase() === 'a') keys.left = true;
            if (e.key === 'ArrowRight' || e.key.toLowerCase() === 'd') keys.right = true;
        });

        window.addEventListener('keyup', (e) => {
            if (e.key === 'ArrowLeft' || e.key.toLowerCase() === 'a') keys.left = false;
            if (e.key === 'ArrowRight' || e.key.toLowerCase() === 'd') keys.right = false;
        });

        // Obsługa sterowania wskaźnikiem (mysz / dotyk) na canvasie
        function handlePointer(clientX) {
            if (!State.arcade.running || State.arcade.paused) return;
            const rect = canvas.getBoundingClientRect();
            // Przeliczenie współrzędnych z uwzględnieniem skalowania CSS
            const scaleX = canvas.width / rect.width;
            const x = (clientX - rect.left) * scaleX;
            
            // Centrowanie gracza na kursorze
            State.arcade.playerX = Math.max(0, Math.min(canvas.width - State.arcade.playerWidth, x - State.arcade.playerWidth / 2));
        }

        canvas.addEventListener('mousemove', (e) => handlePointer(e.clientX));
        canvas.addEventListener('touchmove', (e) => {
            if (e.touches.length > 0) {
                handlePointer(e.touches[0].clientX);
            }
        }, { passive: true });

        // Ustawienie wymiarów płótna z uwzględnieniem pikselizacji
        function resizeCanvas() {
            const rect = canvas.getBoundingClientRect();
            canvas.width = rect.width;
            canvas.height = rect.height;
            // Reset pozycji platformy gracza po zmianie rozdzielczości
            State.arcade.playerX = canvas.width / 2 - State.arcade.playerWidth / 2;
        }

        function startArcadeGame() {
            AudioEngine.playChime();
            showScreen('arcadeScreen');
            document.getElementById('arcadeIntro').classList.remove('hidden');
            
            resizeCanvas();
            window.addEventListener('resize', resizeCanvas);
            
            State.arcade.running = false;
            State.arcade.paused = false;
            State.arcade.score = 0;
            State.arcade.lives = 3;
            State.arcade.elements = [];
            State.arcade.speedMultiplier = 1.0;
            
            document.getElementById('arcadeScore').innerText = '0';
            document.getElementById('arcadeLives').innerText = '3';
        }

        function startArcadeLoop() {
            AudioEngine.playPowerUp();
            document.getElementById('arcadeIntro').classList.add('hidden');
            State.arcade.running = true;
            State.arcade.lastTime = performance.now();
            requestAnimationFrame(arcadeLoop);
        }

        // Główna pętla gry zręcznościowej
        function arcadeLoop(timestamp) {
            if (!State.arcade.running) return;

            if (!State.arcade.paused) {
                updateArcade(timestamp);
            }
            renderArcade();

            requestAnimationFrame(arcadeLoop);
        }

        function updateArcade(timestamp) {
            const dt = timestamp - State.arcade.lastTime;
            State.arcade.lastTime = timestamp;

            // Klawiatura - poruszanie tarczy awaryjnej
            const keyboardSpeed = 6;
            if (keys.left) {
                State.arcade.playerX = Math.max(0, State.arcade.playerX - keyboardSpeed);
            }
            if (keys.right) {
                State.arcade.playerX = Math.min(canvas.width - State.arcade.playerWidth, State.arcade.playerX + keyboardSpeed);
            }

            // Generowanie nowych elementów
            State.arcade.spawnTimer += dt;
            if (State.arcade.spawnTimer >= State.arcade.spawnRate) {
                State.arcade.elements.push(new FallingElement());
                State.arcade.spawnTimer = 0;
                
                // Powolne przyspieszanie gry wraz z postępem
                State.arcade.speedMultiplier += 0.02;
                State.arcade.spawnRate = Math.max(800, 1500 - (State.arcade.score * 15));
            }

            // Aktualizacja obiektów
            for (let i = State.arcade.elements.length - 1; i >= 0; i--) {
                const el = State.arcade.elements[i];
                el.update();

                // Sprawdzenie kolizji z platformą (tarczą) gracza
                const playerY = canvas.height - 40;
                const playerHeight = State.arcade.playerHeight;
                const playerWidth = State.arcade.playerWidth;

                const collisionX = el.x >= State.arcade.playerX && el.x <= State.arcade.playerX + playerWidth;
                const collisionY = (el.y + el.radius >= playerY) && (el.y - el.radius <= playerY + playerHeight);

                if (collisionX && collisionY) {
                    // Wykryto kolizję (Złapanie)
                    if (el.type === 'good') {
                        AudioEngine.playChime();
                        State.arcade.score += 100;
                        State.addScore(100);
                        document.getElementById('arcadeScore').innerText = State.arcade.score;
                    } else {
                        // Złapanie zagrożenia - utrata życia
                        AudioEngine.playHit();
                        State.arcade.lives--;
                        document.getElementById('arcadeLives').innerText = State.arcade.lives;
                        if (State.arcade.lives <= 0) {
                            endArcadeGame();
                        }
                    }
                    State.arcade.elements.splice(i, 1);
                    continue;
                }

                // Usunięcie elementów spadających poniżej dolnej krawędzi
                if (el.y - el.radius > canvas.height) {
                    // Pominięcie dobrego zachowania to mała kara, ale nie kończy gry
                    if (el.type === 'good') {
                        // Tracisz szansę na punkty
                    }
                    State.arcade.elements.splice(i, 1);
                }
            }
        }

        function renderArcade() {
            // Czyszczenie ekranu z lekkim efektem smugi
            ctx.fillStyle = 'rgba(11, 15, 25, 0.4)';
            ctx.fillRect(0, 0, canvas.width, canvas.height);

            // Rysowanie siatki technologicznej w tle (efekt retro)
            ctx.strokeStyle = 'rgba(59, 130, 246, 0.03)';
            ctx.lineWidth = 1;
            const gridSize = 40;
            for (let x = 0; x < canvas.width; x += gridSize) {
                ctx.beginPath();
                ctx.moveTo(x, 0);
                ctx.lineTo(x, canvas.height);
                ctx.stroke();
            }
            for (let y = 0; y < canvas.height; y += gridSize) {
                ctx.beginPath();
                ctx.moveTo(0, y);
                ctx.lineTo(canvas.width, y);
                ctx.stroke();
            }

            // Rysowanie spadających obiektów
            State.arcade.elements.forEach(el => el.draw());

            // Rysowanie Tarczy gracza (Platformy)
            const py = canvas.height - 40;
            const px = State.arcade.playerX;
            const pw = State.arcade.playerWidth;
            const ph = State.arcade.playerHeight;

            ctx.save();
            ctx.beginPath();
            
            // Efekt łuku (tarcza ochronna)
            ctx.moveTo(px, py + ph);
            ctx.quadraticCurveTo(px + pw / 2, py - 10, px + pw, py + ph);
            ctx.lineTo(px + pw, py + ph);
            ctx.lineTo(px, py + ph);
            ctx.closePath();

            ctx.fillStyle = '#10b981';
            ctx.shadowBlur = 20;
            ctx.shadowColor = '#10b981';
            ctx.fill();

            // Pasek technologiczny w środku tarczy
            ctx.beginPath();
            ctx.rect(px + 4, py + ph - 8, pw - 8, 4);
            ctx.fillStyle = '#065f46';
            ctx.fill();

            ctx.restore();
        }

        function toggleArcadePause() {
            if (!State.arcade.running) return;
            State.arcade.paused = !State.arcade.paused;
            const overlay = document.getElementById('arcadePauseOverlay');
            const btn = document.getElementById('arcadePauseBtn');
            
            if (State.arcade.paused) {
                overlay.classList.remove('hidden');
                btn.innerText = "Wznów";
            } else {
                overlay.classList.add('hidden');
                btn.innerText = "Pauza";
                State.arcade.lastTime = performance.now();
            }
        }

        function endArcadeGame() {
            State.arcade.running = false;
            AudioEngine.playBuzzer();
            
            // Powiadomienie o wyniku zręcznościówki bez standardowego alertu
            const modal = document.getElementById('feedbackModal');
            const iconWrap = document.getElementById('feedbackIconWrap');
            const icon = document.getElementById('feedbackIcon');
            const title = document.getElementById('feedbackTitle');
            const text = document.getElementById('feedbackText');
            
            iconWrap.className = "w-16 h-16 rounded-full flex items-center justify-center text-3xl mx-auto bg-amber-500/10 text-amber-400";
            icon.className = "fa-solid fa-trophy";
            title.innerText = "Koniec Rozgrywki";
            title.className = "heading-font text-2xl font-extrabold text-amber-400 text-center space-y-3";
            text.innerHTML = `Twój pancerz tarczy uległ zniszczeniu. <br><br> Zdobyłeś <strong>${State.arcade.score} pkt</strong>, które zasiliły Twój ogólny profil akademii! Zapraszamy do kolejnych podejść, aby pobić rekord.`;

            document.getElementById('nextScenarioBtn').onclick = () => {
                dismissFeedback();
                showScreen('welcomeScreen');
            };

            modal.classList.remove('hidden');
        }

        function quitArcade() {
            State.arcade.running = false;
            showScreen('welcomeScreen');
        }

        // Inicjalizacja całej gry przy załadowaniu okna
        window.onload = function() {
            State.updateRank();
            State.updateBadgeUI();
            showScreen('welcomeScreen');
        }
    </script>
</body>
