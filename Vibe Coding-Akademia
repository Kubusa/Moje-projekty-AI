<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Akademia Bezpieczeństwa - Interaktywna Gra Edukacyjna</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;800&family=Space+Grotesk:wght@400;700&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Outfit', sans-serif;
            background-color: #0b0f19;
            user-select: none;
        }
        .heading-font {
            font-family: 'Space Grotesk', sans-serif;
        }
        /* Efekty świecenia neonowego dla elementów premium */
        .glow-emerald {
            box-shadow: 0 0 20px rgba(16, 185, 129, 0.2);
            border-color: rgba(16, 185, 129, 0.4);
        }
        .glow-amber {
            box-shadow: 0 0 20px rgba(245, 158, 11, 0.2);
            border-color: rgba(245, 158, 11, 0.4);
        }
        .glow-blue {
            box-shadow: 0 0 20px rgba(59, 130, 246, 0.2);
            border-color: rgba(59, 130, 246, 0.4);
        }
        .glow-rose {
            box-shadow: 0 0 20px rgba(244, 63, 94, 0.2);
            border-color: rgba(244, 63, 94, 0.4);
        }
        .custom-scroll::-webkit-scrollbar {
            width: 6px;
        }
        .custom-scroll::-webkit-scrollbar-track {
            background: rgba(15, 23, 42, 0.6);
        }
        .custom-scroll::-webkit-scrollbar-thumb {
            background: rgba(59, 130, 246, 0.5);
            border-radius: 4px;
        }
        canvas {
            display: block;
            touch-action: none;
        }
    </style>
</head>
<body class="relative min-h-screen text-slate-100 flex flex-col justify-between overflow-x-hidden">

    <div class="fixed inset-0 -z-10 bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-slate-900 via-slate-950 to-black overflow-hidden">
        <div class="absolute top-10 left-10 w-72 h-72 bg-blue-500/10 rounded-full blur-3xl animate-pulse"></div>
        <div class="absolute bottom-10 right-10 w-96 h-96 bg-emerald-500/10 rounded-full blur-3xl animate-pulse" style="animation-duration: 8s;"></div>
    </div>

    <!-- Główny Kontener Aplikacji -->
    <header class="w-full max-w-6xl mx-auto px-4 py-4 flex justify-between items-center border-b border-slate-800/60 backdrop-blur-md">
        <div class="flex items-center space-x-3">
            <div class="p-2.5 bg-gradient-to-br from-blue-500 to-indigo-600 rounded-xl shadow-lg shadow-blue-500/20">
                <i class="fa-solid fa-shield-halved text-xl text-white"></i>
            </div>
            <div>
                <h1 class="heading-font text-lg md:text-xl font-bold tracking-tight bg-clip-text text-transparent bg-gradient-to-r from-blue-400 via-indigo-200 to-emerald-400">
                    Akademia Bezpieczeństwa
                </h1>
                <p class="text-[10px] md:text-xs text-slate-400 tracking-wider uppercase font-semibold">Tarcza Edukacyjna v2.0</p>
            </div>
        </div>
        
        <!-- Paski postępu i statystyk w nagłówku -->
        <div class="flex items-center space-x-4">
            <div class="hidden sm:flex flex-col items-end">
                <span class="text-xs text-slate-400">Twój Poziom</span>
                <span id="headerLevel" class="text-sm font-bold text-blue-400 heading-font">Rekrut</span>
            </div>
            <div class="bg-slate-900/80 border border-slate-800 px-3 py-1.5 rounded-lg flex items-center space-x-2">
                <i class="fa-solid fa-award text-yellow-400"></i>
                <span id="globalScore" class="font-bold heading-font text-sm text-yellow-400">0</span>
                <span class="text-[10px] text-slate-500">pkt</span>
            </div>
        </div>
    </header>

    <main class="flex-grow w-full max-w-6xl mx-auto px-4 py-6 flex flex-col justify-center">
        
        <!-- 1. EKRAN STARTOWY -->
        <div id="welcomeScreen" class="space-y-8 py-6 max-w-3xl mx-auto text-center">
            <div class="space-y-4">
                <span class="px-3 py-1 text-xs font-semibold text-blue-400 bg-blue-500/10 border border-blue-500/20 rounded-full uppercase tracking-wider">Gra edukacyjno-zręcznościowa</span>
                <h2 class="heading-font text-4xl md:text-6xl font-extrabold text-white tracking-tight leading-none">
                    Zostań Mistrzem <span class="bg-clip-text text-transparent bg-gradient-to-r from-blue-400 to-emerald-400">Bezpieczeństwa</span>
                </h2>
                <p class="text-slate-400 text-sm md:text-lg max-w-xl mx-auto">
                    Sprawdź swoją wiedzę i refleks w realistycznych sytuacjach zagrożenia. Uratuj dom przed pożarem, zabezpiecz się w sieci, opanuj ruch drogowy i ocal komuś życie!
                </p>
            </div>

            <!-- Karty wyboru trybu -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-left max-w-2xl mx-auto">
                <button onclick="startZoneSelect()" class="group p-5 rounded-2xl bg-slate-900/60 border border-slate-800 hover:border-blue-500/50 hover:bg-slate-900 transition-all duration-300 text-left glow-blue">
                    <div class="flex items-center space-x-4">
                        <div class="p-3 bg-blue-500/10 group-hover:bg-blue-500/20 rounded-xl text-blue-400 transition-colors">
                            <i class="fa-solid fa-compass text-2xl"></i>
                        </div>
                        <div>
                            <h3 class="font-bold text-white text-lg heading-font group-hover:text-blue-300 transition-colors">1. Tryb Scenariuszy</h3>
                            <p class="text-xs text-slate-400 mt-1">Interaktywne wyzwania decyzyjne w 4 kluczowych strefach życia.</p>
                        </div>
                    </div>
                </button>

                <button onclick="startArcadeGame()" class="group p-5 rounded-2xl bg-slate-900/60 border border-slate-800 hover:border-emerald-500/50 hover:bg-slate-900 transition-all duration-300 text-left glow-emerald">
                    <div class="flex items-center space-x-4">
                        <div class="p-3 bg-emerald-500/10 group-hover:bg-emerald-500/20 rounded-xl text-emerald-400 transition-colors">
                            <i class="fa-solid fa-gamepad text-2xl"></i>
                        </div>
                        <div>
                            <h3 class="font-bold text-white text-lg heading-font group-hover:text-emerald-300 transition-colors">2. Łapacz Bezpieczeństwa</h3>
                            <p class="text-xs text-slate-400 mt-1">Dynamiczna zręcznościówka. Chroń tarczą dobre nawyki przed zagrożeniami.</p>
                        </div>
                    </div>
                </button>
            </div>

            <div class="pt-4">
                <button onclick="startZoneSelect()" class="px-8 py-3.5 bg-gradient-to-r from-blue-500 to-indigo-600 hover:from-blue-400 hover:to-indigo-500 text-white font-bold rounded-xl shadow-lg shadow-blue-500/20 transition-all transform hover:-translate-y-0.5 active:translate-y-0 text-sm tracking-wider uppercase">
                    Rozpocznij Naukę <i class="fa-solid fa-arrow-right ml-2"></i>
                </button>
            </div>
        </div>

        <!-- 2. EKRAN WYBORU STREFY -->
        <div id="zoneSelectScreen" class="hidden space-y-6">
            <div class="text-center space-y-2">
                <h3 class="heading-font text-2xl md:text-3xl font-extrabold text-white">Wybierz Strefę Szkoleniową</h3>
                <p class="text-slate-400 text-sm">Zdobądź odznakę z każdej kategorii, aby uzyskać Certyfikat Bezpieczeństwa.</p>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
                <!-- Strefa 1: Dom -->
                <div class="bg-slate-900/50 border border-slate-800/80 rounded-2xl p-5 flex flex-col justify-between space-y-4 hover:bg-slate-900 transition duration-300 relative overflow-hidden group">
                    <div class="absolute top-0 right-0 w-24 h-24 bg-amber-500/5 rounded-full blur-2xl group-hover:bg-amber-500/10 transition-colors"></div>
                    <div class="space-y-3">
                        <div class="w-12 h-12 bg-amber-500/10 text-amber-400 rounded-xl flex items-center justify-center text-xl">
                            <i class="fa-solid fa-house-fire"></i>
                        </div>
                        <h4 class="font-bold text-lg text-white heading-font">Bezpieczny Dom</h4>
                        <p class="text-xs text-slate-400">Pożary kuchenne, instalacje elektryczne i wycieki gazu. Dowiedz się jak reagować!</p>
                    </div>
                    <div class="pt-2">
                        <button onclick="launchZone('dom')" class="w-full py-2 bg-amber-500/10 hover:bg-amber-500 text-amber-400 hover:text-slate-950 font-bold rounded-lg text-xs transition duration-200 uppercase tracking-wider">
                            Uruchom Misję <i class="fa-solid fa-play ml-1"></i>
                        </button>
                    </div>
                </div>

                <!-- Strefa 2: Droga -->
                <div class="bg-slate-900/50 border border-slate-800/80 rounded-2xl p-5 flex flex-col justify-between space-y-4 hover:bg-slate-900 transition duration-300 relative overflow-hidden group">
                    <div class="absolute top-0 right-0 w-24 h-24 bg-blue-500/5 rounded-full blur-2xl group-hover:bg-blue-500/10 transition-colors"></div>
                    <div class="space-y-3">
                        <div class="w-12 h-12 bg-blue-500/10 text-blue-400 rounded-xl flex items-center justify-center text-xl">
                            <i class="fa-solid fa-road"></i>
                        </div>
                        <h4 class="font-bold text-lg text-white heading-font">Mistrz Ruchu</h4>
                        <p class="text-xs text-slate-400">Pasy, odblaski, rowerzyści i hulajnogi elektryczne. Zadbaj o bezpieczeństwo na drodze.</p>
                    </div>
                    <div class="pt-2">
                        <button onclick="launchZone('droga')" class="w-full py-2 bg-blue-500/10 hover:bg-blue-500 text-blue-400 hover:text-slate-950 font-bold rounded-lg text-xs transition duration-200 uppercase tracking-wider">
                            Uruchom Misję <i class="fa-solid fa-play ml-1"></i>
                        </button>
                    </div>
                </div>

                <!-- Strefa 3: Cyber-sieć -->
                <div class="bg-slate-900/50 border border-slate-800/80 rounded-2xl p-5 flex flex-col justify-between space-y-4 hover:bg-slate-900 transition duration-300 relative overflow-hidden group">
                    <div class="absolute top-0 right-0 w-24 h-24 bg-emerald-500/5 rounded-full blur-2xl group-hover:bg-emerald-500/10 transition-colors"></div>
                    <div class="space-y-3">
                        <div class="w-12 h-12 bg-emerald-500/10 text-emerald-400 rounded-xl flex items-center justify-center text-xl">
                            <i class="fa-solid fa-user-shield"></i>
                        </div>
                        <h4 class="font-bold text-lg text-white heading-font">Cyber-Tarcza</h4>
                        <p class="text-xs text-slate-400">Wykrywaj internetowych oszustów, chroń swoje dane i twórz niezniszczalne hasła.</p>
                    </div>
                    <div class="pt-2">
                        <button onclick="launchZone('cyber')" class="w-full py-2 bg-emerald-500/10 hover:bg-emerald-500 text-emerald-400 hover:text-slate-950 font-bold rounded-lg text-xs transition duration-200 uppercase tracking-wider">
                            Uruchom Misję <i class="fa-solid fa-play ml-1"></i>
                        </button>
                    </div>
                </div>

                <!-- Strefa 4: Pierwsza pomoc -->
                <div class="bg-slate-900/50 border border-slate-800/80 rounded-2xl p-5 flex flex-col justify-between space-y-4 hover:bg-slate-900 transition duration-300 relative overflow-hidden group">
                    <div class="absolute top-0 right-0 w-24 h-24 bg-rose-500/5 rounded-full blur-2xl group-hover:bg-rose-500/10 transition-colors"></div>
                    <div class="space-y-3">
                        <div class="w-12 h-12 bg-rose-500/10 text-rose-400 rounded-xl flex items-center justify-center text-xl">
                            <i class="fa-solid fa-kit-medical"></i>
                        </div>
                        <h4 class="font-bold text-lg text-white heading-font">Pierwsza Pomoc</h4>
                        <p class="text-xs text-slate-400">Numery ratunkowe i procedury przedmedyczne. Każda sekunda ma znaczenie!</p>
                    </div>
                    <div class="pt-2">
                        <button onclick="launchZone('pomoc')" class="w-full py-2 bg-rose-500/10 hover:bg-rose-500 text-rose-400 hover:text-slate-950 font-bold rounded-lg text-xs transition duration-200 uppercase tracking-wider">
                            Uruchom Misję <i class="fa-solid fa-play ml-1"></i>
                        </button>
                    </div>
                </div>
            </div>

            <!-- Dolna sekcja powrotu i statystyk -->
            <div class="flex flex-col sm:flex-row justify-between items-center bg-slate-900/30 border border-slate-800/60 rounded-xl p-4 gap-3">
                <button onclick="showScreen('welcomeScreen')" class="px-4 py-2 text-slate-400 hover:text-white hover:bg-slate-800 rounded-lg text-sm transition">
                    <i class="fa-solid fa-arrow-left mr-2"></i> Powrót do menu głównego
                </button>
                <div class="text-xs text-slate-400 flex items-center space-x-3">
                    <span>Odznaki:</span>
                    <span id="badgeCounter" class="bg-indigo-950 text-indigo-300 border border-indigo-800/50 px-2.5 py-0.5 rounded-full font-bold">0 / 4</span>
                </div>
            </div>
        </div>

        <!-- 3. INTERFEJS SCENARIUSZY -->
        <div id="scenarioScreen" class="hidden max-w-2xl mx-auto space-y-6">
            <!-- Górny pasek postępu w scenariuszu -->
            <div class="flex justify-between items-center bg-slate-900/60 border border-slate-800 px-4 py-2 rounded-xl">
                <div class="flex items-center space-x-2 text-xs">
                    <span id="scenarioZoneLabel" class="font-bold tracking-wider uppercase text-blue-400">Strefa</span>
                    <span class="text-slate-600">|</span>
                    <span id="scenarioProgressLabel" class="text-slate-400">Pytanie 1/3</span>
                </div>
                <div class="w-24 bg-slate-800 h-2 rounded-full overflow-hidden">
                    <div id="scenarioProgressBar" class="bg-blue-500 h-full w-0 transition-all duration-300"></div>
                </div>
            </div>

            <!-- Karta Pytania -->
            <div id="questionCard" class="bg-slate-900/80 border border-slate-800 rounded-3xl p-6 md:p-8 space-y-6 relative overflow-hidden shadow-xl">
                <!-- Ikona wizualna strefy w tle -->
                <div class="absolute -top-10 -right-10 w-40 h-40 opacity-5 pointer-events-none text-[120px]" id="bgScenarioIcon">
                    <i class="fa-solid fa-house-fire"></i>
                </div>

                <div class="space-y-3">
                    <div class="inline-flex items-center space-x-1.5 px-3 py-1 rounded-full text-xs font-semibold" id="situationBadge">
                        <i class="fa-solid fa-triangle-exclamation mr-1"></i> Sytuacja kryzysowa
                    </div>
                    <h3 id="scenarioQuestionText" class="heading-font text-xl md:text-2xl font-extrabold text-white leading-snug">
                        Co zrobisz, gdy w kuchni poczujesz silny zapach gazu?
                    </h3>
                </div>

                <!-- Ilustracja wektorowa / opis kontekstowy -->
                <div id="scenarioContext" class="p-4 bg-slate-950/60 border border-slate-800/80 rounded-2xl text-sm text-slate-300 leading-relaxed italic">
                    "Wchodzisz do domu i czujesz charakterystyczny, nieprzyjemny zapach. Zdajesz sobie sprawę, że to gaz z kuchenki..."
                </div>

                <!-- Opcje odpowiedzi (generowane dynamicznie) -->
                <div id="optionsContainer" class="grid grid-cols-1 gap-3">
                    <!-- Przykład przycisku wyboru -->
                    <button class="w-full text-left p-4 rounded-xl bg-slate-950/40 border border-slate-800/80 hover:border-slate-700 hover:bg-slate-950 text-sm font-semibold transition flex justify-between items-center group">
                        <span>Zapalę światło, aby sprawdzić kuchenkę.</span>
                        <i class="fa-solid fa-chevron-right text-slate-600 group-hover:text-slate-400 transition-colors"></i>
                    </button>
                </div>
            </div>
        </div>

        <!-- 4. MODAL EDUKACYJNY / WYNIK ODPOWIEDZI -->
        <div id="feedbackModal" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/80 backdrop-blur-sm transition-opacity duration-300">
            <div class="bg-slate-900 border border-slate-800 w-full max-w-lg rounded-3xl overflow-hidden shadow-2xl transform scale-95 transition-transform duration-300" id="feedbackContent">
                <!-- Nagłówek statusu (Dobrze / Źle) -->
                <div id="feedbackHeader" class="p-6 text-center space-y-3">
                    <div id="feedbackIconWrap" class="w-16 h-16 rounded-full flex items-center justify-center text-3xl mx-auto">
                        <i id="feedbackIcon" class="fa-solid fa-circle-check"></i>
                    </div>
                    <h4 id="feedbackTitle" class="heading-font text-2xl font-extrabold">Doskonały Wybór!</h4>
                </div>

                <!-- Treść Edukacyjna -->
                <div class="p-6 space-y-4 bg-slate-950/40 border-t border-b border-slate-800/60">
                    <p id="feedbackText" class="text-sm text-slate-300 leading-relaxed">
                        Gaz jest wysoce łatwopalny. Włączenie światła mogłoby wywołać iskrę w instalacji elektrycznej, doprowadzając do potężnego wybuchu!
                    </p>
                    <div class="flex items-center space-x-2 bg-blue-500/10 border border-blue-500/20 rounded-xl p-3 text-xs text-blue-300">
                        <i class="fa-solid fa-circle-info text-blue-400 text-sm"></i>
                        <span><strong>Zasada:</strong> Wietrzenie, brak ognia/iskier i ewakuacja to absolutny priorytet.</span>
                    </div>
                </div>

                <!-- Przycisk Kontynuacji -->
                <div class="p-6 flex justify-end">
                    <button id="nextScenarioBtn" onclick="dismissFeedback()" class="px-6 py-2.5 bg-slate-800 hover:bg-slate-700 text-white font-bold rounded-xl transition-all text-sm tracking-wide uppercase">
                        Dalej <i class="fa-solid fa-arrow-right ml-1"></i>
                    </button>
                </div>
            </div>
        </div>

        <!-- 5. EKRAN MINIGRY ZRĘCZNOŚCIOWEJ -->
        <div id="arcadeScreen" class="hidden space-y-4 max-w-4xl mx-auto">
            <div class="flex flex-col sm:flex-row justify-between items-center bg-slate-900/60 border border-slate-800 p-4 rounded-2xl gap-3">
                <div class="flex items-center space-x-3">
                    <div class="p-2 bg-emerald-500/10 text-emerald-400 rounded-lg">
                        <i class="fa-solid fa-shield-cat text-lg"></i>
                    </div>
                    <div>
                        <h3 class="heading-font font-bold text-white leading-none">Łapacz Bezpieczeństwa</h3>
                        <p class="text-[10px] text-slate-400">Steruj tarczą za pomocą myszy/dotyku lub strzałek</p>
                    </div>
                </div>

                <!-- Statystyki na żywo w minigrze -->
                <div class="flex items-center space-x-4 text-sm font-bold">
                    <div class="text-emerald-400 flex items-center space-x-1.5 bg-emerald-500/5 px-2.5 py-1 rounded-lg border border-emerald-500/15">
                        <span>Punkty:</span>
                        <span id="arcadeScore" class="heading-font">0</span>
                    </div>
                    <div class="text-rose-400 flex items-center space-x-1.5 bg-rose-500/5 px-2.5 py-1 rounded-lg border border-rose-500/15">
                        <span>Życia:</span>
                        <span id="arcadeLives" class="heading-font">3</span>
                    </div>
                </div>

                <!-- Przyciski akcji -->
                <div class="flex items-center space-x-2">
                    <button id="arcadePauseBtn" onclick="toggleArcadePause()" class="px-3 py-1.5 bg-slate-800 hover:bg-slate-700 rounded-lg text-xs font-bold transition text-slate-300">
                        Pauza
                    </button>
                    <button onclick="quitArcade()" class="px-3 py-1.5 bg-rose-500/10 hover:bg-rose-500 text-rose-400 hover:text-white rounded-lg text-xs font-bold transition">
                        Wyjdź
                    </button>
                </div>
            </div>

            <!-- Interaktywny Canvas dla Minigry -->
            <div class="relative w-full aspect-[4/3] max-h-[500px] rounded-3xl overflow-hidden border-2 border-slate-800 bg-slate-950 shadow-2xl">
                <!-- Instrukcja przed startem gry -->
                <div id="arcadeIntro" class="absolute inset-0 z-10 flex flex-col items-center justify-center bg-slate-950/90 p-6 text-center space-y-4">
                    <div class="w-16 h-16 bg-emerald-500/10 text-emerald-400 rounded-full flex items-center justify-center text-3xl animate-bounce">
                        <i class="fa-solid fa-gamepad"></i>
                    </div>
                    <h4 class="heading-font text-xl md:text-2xl font-extrabold text-white">Chroń Dobre Nawyki!</h4>
                    <p class="text-slate-400 text-xs md:text-sm max-w-sm leading-relaxed">
                        Poruszaj zieloną <strong>Tarczą Bezpieczeństwa</strong>. Łap bezpieczne zachowania (zielone) i omijaj niebezpieczne (czerwone).
                    </p>
                    <div class="grid grid-cols-2 gap-4 text-left text-xs bg-slate-900/60 p-3 rounded-xl max-w-xs border border-slate-800">
                        <div class="text-emerald-400 font-bold"><i class="fa-solid fa-circle-check mr-1"></i> Łap: Kaski, Odblaski, Pasy, Silne Hasła</div>
                        <div class="text-rose-400 font-bold"><i class="fa-solid fa-triangle-exclamation mr-1"></i> Unikaj: Ognia, Phishingu, Kabli, Czerwonego światła</div>
                    </div>
                    <button onclick="startArcadeLoop()" class="px-6 py-2.5 bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-bold rounded-xl shadow-lg transition duration-200 text-sm tracking-wider uppercase">
                        Zagraj Teraz <i class="fa-solid fa-circle-play ml-1"></i>
                    </button>
                </div>

                <!-- Overlay pauzy -->
                <div id="arcadePauseOverlay" class="hidden absolute inset-0 z-10 flex flex-col items-center justify-center bg-black/80 text-center space-y-3">
                    <h4 class="heading-font text-2xl font-extrabold text-amber-400 uppercase tracking-widest">Gra Wstrzymana</h4>
                    <p class="text-slate-400 text-sm">Odpocznij chwilę i wznów, kiedy będziesz gotowy.</p>
                    <button onclick="toggleArcadePause()" class="px-5 py-2 bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold rounded-lg text-xs uppercase tracking-wider transition">
                        Wznów Lot <i class="fa-solid fa-play ml-1"></i>
                    </button>
                </div>

                <canvas id="arcadeCanvas" class="w-full h-full"></canvas>
            </div>
        </div>

        <!-- 6. EKRAN PODSUMOWANIA (CERTYFIKAT) -->
        <div id="summaryScreen" class="hidden max-w-lg mx-auto text-center space-y-6">
            <div class="bg-slate-900/80 border-2 border-indigo-500/40 rounded-3xl p-6 md:p-8 space-y-6 relative overflow-hidden shadow-2xl glow-blue">
                <!-- Zdobiony certyfikat wizualny -->
                <div class="absolute inset-0 bg-gradient-to-t from-indigo-500/5 to-transparent pointer-events-none"></div>
                
                <div class="space-y-3">
