            addScore(pts) {
                this.globalScore += pts;
                localStorage.setItem('edu_safety_score', this.globalScore);
                document.getElementById('globalScore').innerText = this.globalScore;
                this.updateRank();
            },

            unlockBadge(zone) {
                if (!this.unlockedBadges.includes(zone)) {
                    this.unlockedBadges.push(zone);
                    localStorage.setItem('edu_safety_badges', JSON.stringify(this.unlockedBadges));
                    AudioEngine.playPowerUp();
